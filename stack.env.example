SILO_BASE_URL=https://silo.example.com
SILO_TOKEN=replace-with-your-silo-api-key
# Generate a separate token: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SILO_MCP_AUTH_TOKEN=
SILO_READONLY=1
# For a reverse proxy, include its public hostname (and port if nonstandard).
SILO_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
